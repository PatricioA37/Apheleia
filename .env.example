# Apheleia — variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.

# --- Modelo de razonamiento (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Embeddings (Voyage AI) ---
# voyage-4-large  -> biblioteca clínica
# voyage-4-lite   -> memoria de paciente y consultas en vivo
VOYAGE_API_KEY=pa-...

# --- Base de datos (Supabase) ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=

# --- Entorno ---
# lab = datos sintéticos únicamente (obligatorio durante el evento)
ENTORNO=lab
